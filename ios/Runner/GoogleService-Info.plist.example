<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE - download the real file from Firebase console > Project settings >
  Your apps > iOS and save it as ios/Runner/GoogleService-Info.plist
  (git-ignored). Add it to the Runner target in Xcode. Do not commit it.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>&lt;IOS_API_KEY&gt;</string>
	<key>GCM_SENDER_ID</key>
	<string>&lt;SENDER_ID&gt;</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>&lt;IOS_BUNDLE_ID&gt;</string>
	<key>PROJECT_ID</key>
	<string>&lt;FIREBASE_PROJECT_ID&gt;</string>
	<key>STORAGE_BUCKET</key>
	<string>&lt;FIREBASE_PROJECT_ID&gt;.firebasestorage.app</string>
	<key>GOOGLE_APP_ID</key>
	<string>&lt;IOS_APP_ID&gt;</string>
	<key>CLIENT_ID</key>
	<string>&lt;IOS_OAUTH_CLIENT_ID&gt;.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.&lt;IOS_CLIENT_ID_PREFIX&gt;</string>
</dict>
</plist>
